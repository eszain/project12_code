# Copy to .env and adjust. Every setting is optional; the defaults run the MVP locally
# without credentials (AC06). Real credentials belong in .env only (it is git-ignored, NFR04).

# Database. SQLite by default; PostgreSQL works through SQLAlchemy, e.g.
# CADS_DATABASE_URL=postgresql+psycopg://cads:password@localhost:5432/cads
# Tip: if this folder is synced by OneDrive, keep the SQLite file outside the synced folder.
CADS_DATABASE_URL=sqlite:///var/cads.db

# Reference clock used for "time to TCA" and event status. "system" = wall clock.
# For replaying the Feb 2026 sample CDMs, pin it to a moment after the last CDM was issued:
CADS_CLOCK=2026-02-26T15:00:00Z

# Encounter correlation window: CDMs for the same object pair whose TCAs differ by at most
# this many seconds are treated as revisions of one encounter (team proposal: +/-60 s, to confirm with CSA).
CADS_CORRELATION_WINDOW_S=60

# Risk thresholds on the SOURCE Pc. 1e-4 is the action level CSA mentioned; 1e-7 is a "watch" level
# borrowed from common NASA CARA practice (to confirm with CSA).
CADS_PC_ACTION_THRESHOLD=1e-4
CADS_PC_WATCH_THRESHOLD=1e-7

# Hard-body radius used for the experimental Pc recalculation when the CDM gives no usable size.
CADS_DEFAULT_HBR_M=10

# Provisional 1-sigma position-uncertainty limits (radial, in-track, cross-track) in metres,
# as read from the CSA spreadsheet screenshot (to confirm with CSA).
CADS_QUALITY_LIMITS_M=200,1000,1000

# Notifications
CADS_NOTIFICATION_DIR=var/notifications
CADS_RETRY_BASE_S=30
CADS_MAX_DELIVERY_ATTEMPTS=5
CADS_DISPATCHER_INTERVAL_S=5
CADS_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Email channel (disabled unless CADS_SMTP_HOST is set)
CADS_SMTP_HOST=
CADS_SMTP_PORT=587
CADS_SMTP_USER=
CADS_SMTP_PASSWORD=
CADS_SMTP_FROM=cads-alerts@example.org
CADS_SMTP_STARTTLS=true

# Space-Track adapter (prototype; not used unless both are set and CSA approves the account use)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=
