skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #3A3A3A
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 11
skinparam roundCorner 10
skinparam class {
  BackgroundColor #F2F2F2
  BorderColor #6B6B6B
  HeaderBackgroundColor #E0E0E0
  FontStyle bold
}
skinparam component {
  BackgroundColor #E0E0E0
  BorderColor #6B6B6B
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #A0A0A0
  FontStyle bold
}
skinparam database {
  BackgroundColor #EFEFEF
  BorderColor #7A7A7A
}
skinparam note {
  BackgroundColor #F7F7F7
  BorderColor #9A9A9A
}
skinparam state {
  BackgroundColor #F2F2F2
  BorderColor #6B6B6B
}
skinparam activity {
  BackgroundColor #F2F2F2
  BorderColor #6B6B6B
  DiamondBackgroundColor #EFEFEF
  DiamondBorderColor #7A7A7A
}
skinparam sequence {
  ParticipantBackgroundColor #E0E0E0
  ParticipantBorderColor #6B6B6B
  LifeLineBorderColor #8A8A8A
  ActorBorderColor #3A3A3A
}
skinparam classAttributeIconSize 0
skinparam ActorBackgroundColor #E0E0E0
skinparam ArrowColor #3A3A3A
skinparam DatabaseBackgroundColor #EFEFEF
skinparam LifeLineBackgroundColor #F2F2F2
