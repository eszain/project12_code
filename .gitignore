var/
*.db
*.db-journal

# Local configuration and credentials: never commit (NFR04)
.env

# Original Space-Track / CSA sample files: check redistribution permission with CSA before committing
data/samples/space-track/*.json
data/samples/space-track/*.kvn
data/samples/space-track/*.txt

# The ESA Kelvins CSVs (about 320 MB) stay local. The converted 30-event sample in web/public/esa-sample/ is committed
# so the hosted dashboard can show it; see docs/esa-dataset.md.
data/esa/
